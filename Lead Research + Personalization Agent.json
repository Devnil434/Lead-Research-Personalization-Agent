    {
      "parameters": {
        "jsCode": "return items.map(item => {\n\n  // =========================\n  // EXTRACT AI TEXT\n  // =========================\n\n  let raw = \"\";\n\n  if (\n    item.json.output &&\n    item.json.output[0] &&\n    item.json.output[0].content &&\n    item.json.output[0].content[0] &&\n    item.json.output[0].content[0].text\n  ) {\n    raw = item.json.output[0].content[0].text;\n  } else {\n    return {\n      json: {\n        error: \"No AI text found\"\n      }\n    };\n  }\n\n  // =========================\n  // CLEAN JSON\n  // =========================\n\n  raw = raw\n    .replace(/```json/g, \"\")\n    .replace(/```/g, \"\")\n    .trim();\n\n  // =========================\n  // PARSE JSON\n  // =========================\n\n  let parsed;\n\n  try {\n    parsed = JSON.parse(raw);\n  } catch (err) {\n    return {\n      json: {\n        error: \"JSON Parse Failed\",\n        details: err.message,\n        raw_response: raw\n      }\n    };\n  }\n\n  // =========================\n  // RETURN FINAL STRUCTURE\n  // =========================\n\n  return {\n    json: {\n\n      company_name: parsed.company_name || \"\",\n      company_url: parsed.company_url || \"\",\n      company_summary: parsed.company_summary || \"\",\n      industry: parsed.industry || \"\",\n      company_type: parsed.company_type || \"\",\n      lead_score: parsed.lead_score || \"\",\n      fit_score: parsed.fit_score || 0,\n      reasoning: parsed.reasoning || \"\",\n      growth_opportunities: parsed.growth_opportunities || \"\",\n      competitors: parsed.competitors || \"\",\n\n      subject_line_1: parsed.subject_line_1 || \"\",\n      subject_line_2: parsed.subject_line_2 || \"\",\n      subject_line_3: parsed.subject_line_3 || \"\",\n\n      outreach_message_1:\n        parsed.outreach_messages?.[0] || \"\",\n\n      outreach_message_2:\n        parsed.outreach_messages?.[1] || \"\",\n\n      outreach_message_3:\n        parsed.outreach_messages?.[2] || \"\",\n\n      confidence: parsed.confidence || \"\",\n\n      data_quality_issues:\n        Array.isArray(parsed.data_quality_issues)\n          ? parsed.data_quality_issues.join(\" | \")\n          : \"\"\n\n    }\n  };\n\n});"
      },
