        "mode": "runOnceForEachItem",
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nlet html = item.json.body || \"\";\n\n// Clean HTML\nhtml = html\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, \"\")\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, \"\")\n  .replace(/<[^>]+>/g, \" \")\n  .replace(/\\s+/g, \" \")\n  .trim()\n  .slice(0, 4000);\n\nreturn {\n  json: {\n    company_name: item.json.company_name,\n    company_url: item.json.company_url,\n    cleaned_text: html\n  }\n};"
      },
